#!/bin/bash
set -uo pipefail

export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_DEFAULT_REGION=us-east-1
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test

# Bind to 127.0.0.1 only: Floci and terraform run in the same container,
# nothing outside it needs to reach the emulator.
/usr/local/bin/floci-aws -Dquarkus.http.host=127.0.0.1 &

ready=false
for _ in $(seq 1 30); do
  if exec 3<>/dev/tcp/127.0.0.1/4566 2>/dev/null; then
    printf 'GET /_floci/init HTTP/1.0\r\nHost: localhost\r\n\r\n' >&3
    response=$(cat <&3)
    exec 3<&- 2>/dev/null
    if [[ "$response" == *'"ready":true'* ]]; then
      ready=true
      break
    fi
  fi
  sleep 1
done

if [ "$ready" != true ]; then
  echo "Floci não respondeu a tempo" >&2
  exit 1
fi

exec "$@"
